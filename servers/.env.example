# WebSocket 网关端口（默认 8080）
GATEWAY_PORT=8080

# 允许的前端来源，多个用逗号分隔，留空表示允许所有
# ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# 默认提供方：openai | deepseek | ollama | custom
DEFAULT_PROVIDER=deepseek

# ——— DeepSeek ———
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxx
# 默认使用 https://api.deepseek.com/v1，无需修改
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_DEFAULT_MODEL=deepseek-chat

# ——— OpenAI ———
# OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxx
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_DEFAULT_MODEL=gpt-4o

# ——— Ollama（本地，无需 API Key，开箱即用）———
# 默认连接 http://localhost:11434/v1，无需任何配置即可使用
# OLLAMA_BASE_URL=http://localhost:11434/v1
# OLLAMA_DEFAULT_MODEL=qwen3-vl:8b   # 可选：qwen3-vl:8b / qwen3.5:4b / llama3.2

# ——— 自定义兼容服务（如本地 vLLM / LM Studio）———
# CUSTOM_API_KEY=xxx
# CUSTOM_BASE_URL=http://localhost:8000/v1
# CUSTOM_DEFAULT_MODEL=qwen3.5:14b
